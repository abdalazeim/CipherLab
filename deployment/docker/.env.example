# ==============================================================================
# Environment Variables — General Development System (GDS) (Docker)
# Copy to .env and fill in your values
# ==============================================================================

# ─── Django ───────────────────────────────────────────────────────
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True

# ─── Database (PostgreSQL) ────────────────────────────────────────
# Local Docker: postgresql://gds:gds@db:5432/gds_dev
# Production:   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://gds:gds@db:5432/gds_dev

# ─── Hosts / Origins ──────────────────────────────────────────────
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Security (production only) ───────────────────────────────────
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ─── Email ────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ─── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_LOGIN=30/m
RATE_LIMIT_API=120/m

# ─── Celery / Redis ───────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
